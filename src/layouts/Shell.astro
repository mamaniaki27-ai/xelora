---
import '../styles/global.css';
import App from '../components/App';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark h-full" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0c0e12" />
    <meta
      name="description"
      content="Wallet-first trading interface for spot markets, perpetual futures, and swaps."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('xelora-theme');
          var locale = localStorage.getItem('xelora-locale');
          if (theme === 'light') document.documentElement.classList.remove('dark');
          if (locale === 'fa') {
            document.documentElement.lang = 'fa';
            document.documentElement.dir = 'rtl';
          }
          var dark = document.documentElement.classList.contains('dark');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#0c0e12' : '#f4f6f8');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-full bg-bg text-ink antialiased">
    <App client:only="react" />
  </body>
</html>
